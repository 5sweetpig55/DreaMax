---
import { profile } from "../../data/profile";
import ScrollIndicator from "../ui/ScrollIndicator.astro";
---

<section id="dreamax" class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden" style="padding-top:64px;">

  <!-- Code element -->
  <div class="code-sig" id="dreamax-code" onclick="window.location.reload()" title="Reload page" style="position:absolute; top:88px; left:50%; transform:translateX(-50%); z-index:10; cursor:pointer; user-select:none;">
    <span style="display:flex; align-items:center; font-family:'JetBrains Mono',monospace; font-size:20px; font-weight:500;">
      <span style="color:rgba(255,255,255,0.35);">&lt;</span>
      <span style="color:#569cd6; font-weight:600;">DreaMax</span>
      <span class="code-sig-extra" style="overflow:hidden; white-space:nowrap; max-width:0px; opacity:0; display:inline-block; vertical-align:bottom; transition:max-width 0.5s cubic-bezier(0.4,0,0.2,1), opacity 0.3s ease;">
        <span style="color:#9cdcfe;">&nbsp;onClick</span>
        <span style="color:rgba(255,255,255,0.3);">=</span>
        <span style="color:#ce9178;">&#123;reload&#125;</span>
      </span>
      <span style="color:#c586c0;"> /&gt;</span>
    </span>
  </div>

  <!-- Content -->
  <div class="relative z-10 flex w-full max-w-6xl flex-col items-center px-6" style="margin-top:80px;">

    <h1 style="font-family:'JetBrains Mono',monospace; font-size:clamp(52px, 12vw, 120px); font-weight:800; line-height:1.2; letter-spacing:4px; color:#ffffff; text-align:center;">
      {profile.name}
    </h1>

    <!-- VS Code block with AI/CS flavor -->
    <div class="relative w-full max-w-3xl" style="margin-top:8px;">
      <div class="select-none" style="font-family:'JetBrains Mono',monospace; font-size:clamp(11px, 1.8vw, 14px); line-height:1.9; text-align:center; padding:16px 0; color:rgba(255,255,255,0.45);">
        <span style="color:#569cd6; opacity:0.5;">&lt;html</span> <span style="color:#9cdcfe; opacity:0.5;">lang</span><span style="color:rgba(255,255,255,0.25); opacity:0.5;">=</span><span style="color:#ce9178; opacity:0.5;">"en"</span><span style="color:#569cd6; opacity:0.5;">&gt;</span><br/>
        <span style="opacity:0.45;">&nbsp;&nbsp;&lt;</span><span style="color:#569cd6; opacity:0.45;">head</span><span style="color:#569cd6; opacity:0.45;">&gt;</span><br/>
        <span style="opacity:0.45;">&nbsp;&nbsp;&nbsp;&nbsp;&lt;</span><span style="color:#569cd6; opacity:0.45;">meta</span> <span style="color:#9cdcfe; opacity:0.45;">name</span><span style="color:rgba(255,255,255,0.25); opacity:0.45;">=</span><span style="color:#ce9178; opacity:0.45;">"viewport"</span> <span style="color:#9cdcfe; opacity:0.45;">content</span><span style="color:rgba(255,255,255,0.25); opacity:0.45;">=</span><span style="color:#ce9178; opacity:0.45;">"width=device-width, initial-scale=1.0"</span><span style="color:#569cd6; opacity:0.45;">&gt;</span><br/>
        <span style="opacity:0.45;">&nbsp;&nbsp;&nbsp;&nbsp;&lt;</span><span style="color:#569cd6; opacity:0.45;">title</span><span style="color:#569cd6; opacity:0.45;">&gt;</span><span style="color:rgba(255,255,255,0.35);">What do I do</span><span style="opacity:0.45;">&lt;/</span><span style="color:#569cd6; opacity:0.45;">title</span><span style="opacity:0.45;">&gt;</span><br/>
        <span style="opacity:0.45;">&nbsp;&nbsp;&lt;/</span><span style="color:#569cd6; opacity:0.45;">head</span><span style="opacity:0.45;">&gt;</span><br/>
        <span style="opacity:0.45;">&nbsp;&nbsp;&lt;</span><span style="color:#569cd6; opacity:0.45;">body</span><span style="color:#569cd6; opacity:0.45;">&gt;</span><br/>
        <span style="opacity:0.45;">&nbsp;&nbsp;&nbsp;&nbsp;&lt;</span><span style="color:#569cd6; opacity:0.45;">h1</span><span style="color:#569cd6; opacity:0.45;">&gt;</span><span style="color:rgba(255,255,255,0.35);">Things I do to get a perfect background image</span><span style="opacity:0.45;">&lt;/</span><span style="color:#569cd6; opacity:0.45;">h1</span><span style="opacity:0.45;">&gt;</span><br/>
        <span style="opacity:0.45;">&nbsp;&nbsp;&nbsp;&nbsp;&lt;</span><span style="color:#569cd6; opacity:0.45;">p</span><span style="color:#569cd6; opacity:0.45;">&gt;</span><span style="color:rgba(255,255,255,0.35);">Maybe I should stop tinkering with VSCode settings</span><br/>
        <span style="color:rgba(255,255,255,0.30);">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;just to take a screenshot of this dummy html code.</span><span style="opacity:0.45;">&lt;/</span><span style="color:#569cd6; opacity:0.45;">p</span><span style="opacity:0.45;">&gt;</span><br/>
        <span style="opacity:0.45;">&nbsp;&nbsp;&nbsp;&nbsp;&lt;</span><span style="color:#569cd6; opacity:0.45;">span</span><span style="color:#569cd6; opacity:0.45;">&gt;</span><span style="color:rgba(255,255,255,0.35);">Oops, Almost forgot to say "Hello World!".</span><span style="opacity:0.45;">&lt;/</span><span style="color:#569cd6; opacity:0.45;">span</span><span style="opacity:0.45;">&gt;</span><br/>
        <span style="opacity:0.45;">&nbsp;&nbsp;&lt;/</span><span style="color:#569cd6; opacity:0.45;">body</span><span style="opacity:0.45;">&gt;</span><br/>
        <span style="color:#569cd6; opacity:0.5;">&lt;/html&gt;</span>
      </div>
      <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(to bottom, transparent 0%, transparent 20%, #121216 100%);"></div>
    </div>

    <!-- Title -->
    <p style="font-family:'Roboto Mono',monospace; font-size:clamp(13px, 1.8vw, 16px); letter-spacing:2px; color:rgba(255,255,255,0.70); text-align:center; margin-top:2px; position:relative; z-index:2;">
      {profile.title}
    </p>

    <!-- Email as code -->
    <div style="display:flex; align-items:center; gap:6px; margin-top:18px; position:relative; z-index:2;">
      <span style="font-family:'JetBrains Mono',monospace; font-size:clamp(11px, 1.2vw, 13px);">
        <span style="color:#c586c0; opacity:0.45;">export</span>
        <span style="color:#569cd6; opacity:0.45;"> const</span>
        <span style="color:#9cdcfe; opacity:0.4;"> email</span>
        <span style="color:rgba(255,255,255,0.2);"> =</span>
        <span style="color:#ce9178; opacity:0.5;">"</span>
        <a href="mailto:{profile.email}" style="font-family:'JetBrains Mono',monospace; color:#ce9178; opacity:0.55; text-decoration:none; transition:opacity 0.3s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.55'">{profile.email}</a>
        <span style="color:#ce9178; opacity:0.5;">"</span>
      </span>
    </div>

    <!-- Quote below email — single line -->
    <div style="margin-top:20px; position:relative; z-index:2; text-align:center;">
      <p style="font-family:'JetBrains Mono',monospace; font-size:clamp(11px, 1.2vw, 13px); color:#ff6b2b; opacity:0.45; letter-spacing:1px; margin:0;">
        "It&rsquo;s about a man who has nothing, who risks everything, to feel something." &mdash; <span style="color:#66d9ed;">Jessica Day</span>
      </p>
    </div>

    <!-- Buttons -->
    <div class="flex flex-wrap justify-center gap-4" style="margin-top:32px; position:relative; z-index:2;">
      <a href="/machine-learning" class="btn btn-pink">View Research <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a href="/join" class="btn btn-ghost">Explore Projects <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
    </div>
  </div>

  <!-- Mission statement — right side on desktop -->
  <div class="hidden md:block" style="position:fixed; right:40px; top:50%; transform:translateY(-50%); max-width:180px; text-align:right; z-index:5;">
    <div style="border-right:2px solid rgba(102,217,237,0.15); padding-right:24px;">
      <p style="font-family:'JetBrains Mono',monospace; font-size:clamp(13px, 1.4vw, 17px); color:rgba(255,255,255,0.45); line-height:1.8; margin:0; font-weight:300; letter-spacing:1px;">
        A website<br/>for everyone<br/>to learn and<br/><span style="color:#e31b6d; font-weight:700; letter-spacing:3px;">change the world!</span>
      </p>
      <p style="font-family:'JetBrains Mono',monospace; font-size:clamp(9px, 0.9vw, 10px); color:#c586c0; opacity:0.2; margin-top:14px; letter-spacing:4px;">
        &lt; version 1.0 &gt;
      </p>
    </div>
  </div>

  <!-- Mobile mission statement -->
  <div class="md:hidden" style="margin-top:36px; text-align:center; padding:16px 0; border-top:1px solid rgba(255,255,255,0.04);">
    <p style="font-family:'JetBrains Mono',monospace; font-size:13px; color:rgba(255,255,255,0.45); line-height:1.6; letter-spacing:1px; margin:0;">
      A website for everyone to learn and <span style="color:#e31b6d; font-weight:700;">change the world!</span>
    </p>
    <p style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#c586c0; opacity:0.2; margin-top:8px; letter-spacing:4px;">&lt; version 1.0 &gt;</p>
  </div>
    </div>
  </div>

  <div class="flex w-full max-w-5xl items-end px-6" style="padding-bottom:50px; margin-top:auto;">
    <div style="margin-left:auto;"><ScrollIndicator /></div>
  </div>
</section>

<style>
  #dreamax-code:hover .code-sig-extra { max-width: 320px !important; opacity: 1 !important; }
</style>
