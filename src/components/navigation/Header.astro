---
import { navigation } from "../../data/navigation";
import { profile } from "../../data/profile";
const path = Astro.url.pathname;
---

<header class="glass-header fixed top-0 left-0 right-0 z-50">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/" class="font-mono text-base font-bold tracking-widest text-white/90 transition-colors duration-200 hover:text-[#66d9ed]">
      DREA<span class="text-[#66d9ed]">MAX</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {navigation.map((item) => {
        const isActive = path === item.href || (item.href !== "/" && path.startsWith(item.href));
        return (
          <li>
            <a href={item.href}
              class="relative px-3 py-2 font-mono text-xs tracking-wider transition-colors duration-200"
              style={{ color: isActive ? '#66d9ed' : 'rgba(255,255,255,0.45)', fontWeight: isActive ? 600 : 400 }}
              onmouseover="this.style.color='#ffffff'"
              onmouseout="this.style.color=this.getAttribute('data-restore')"
              data-restore={isActive ? '#66d9ed' : 'rgba(255,255,255,0.45)'}
            >
              {item.label}
              {isActive && <span class="absolute bottom-0 left-3 right-3 h-[1.5px] bg-[#66d9ed]" />}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Colored social icons -->
    <div class="hidden items-center gap-2 md:flex">
      <a href={profile.social.github} target="_blank" class="flex h-9 w-9 items-center justify-center rounded border border-white/8 transition-all duration-300 hover:border-[#333] hover:bg-white/5" title="GitHub" style="color:#888;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href={profile.social.googleScholar} target="_blank" class="flex h-9 w-9 items-center justify-center rounded border border-white/8 transition-all duration-300 hover:border-[#4285f4]/40" title="Google Scholar" style="color:#4285f4;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 100 14 7 7 0 000-14z"/></svg>
      </a>
      <a href={profile.social.csdn} target="_blank" class="flex h-9 w-9 items-center justify-center rounded border border-white/8 transition-all duration-300 hover:border-[#e31b6d]/40" title="CSDN" style="color:#e31b6d;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M3.8 6.8c0-.3.2-.5.4-.7.2-.2.5-.3.8-.3h13.9c.3 0 .6.1.8.3.2.2.4.4.4.7v.1l-1.5 3.4c-.1.3-.4.5-.7.5h-9.5l-.7 1.6h8.4c.5 0 .9.2 1.2.6.3.4.4.8.2 1.3l-1.9 4.3c-.2.4-.5.7-.9.9-.4.2-.8.3-1.2.3H6.7c-.6 0-1.1-.2-1.5-.7-.4-.5-.6-1-.5-1.6L6 13.1l2.7-6.3H3.8z"/></svg>
      </a>
    </div>

    <button id="menu-toggle" class="flex items-center text-white/40 md:hidden" aria-label="Toggle menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-white/5 bg-[#121216] px-6 pb-4 md:hidden">
    <ul class="flex flex-col gap-1 pt-2">
      {navigation.map((item) => {
        const isActive = path === item.href || (item.href !== "/" && path.startsWith(item.href));
        return (
          <li><a href={item.href} class="block rounded px-3 py-2 font-mono text-sm tracking-wider transition-colors duration-200" style={{ color: isActive ? '#66d9ed' : 'rgba(255,255,255,0.45)', background: isActive ? 'rgba(102,217,237,0.06)' : 'transparent' }}>{item.label}</a></li>
        );
      })}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => menu.classList.toggle("hidden"));
  }
</script>
