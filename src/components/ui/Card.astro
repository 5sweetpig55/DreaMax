---
interface Props {
  class?: string;
  clickable?: boolean;
}

const { class: className = "", clickable = false } = Astro.props;
const base = "rounded-sm border border-white/8 bg-[#131316]/60 backdrop-blur-sm card";
const hoverCls = clickable ? "hover:-translate-y-[3px] hover:shadow-[0_8px_30px_rgba(0,0,0,0.5)] hover:border-white/20 cursor-pointer" : "";
const cls = `${base} ${hoverCls} ${className}`;
---

<div class={cls} data-clickable={clickable ? "true" : undefined}>
  <slot />
</div>
