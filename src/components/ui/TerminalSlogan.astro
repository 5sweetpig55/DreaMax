<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&family=Audiowide&display=swap" rel="stylesheet">
<div id="ts-wrap" class="ts-wrap"></div>
<script>
(function(){
  var C = document.getElementById('ts-wrap');
  if(!C) return;
  var allBlocks = [], bounceTimer = null, hoverEnabled = true;
  var lines = [
    {text:'A website'},{text:'for everyone'},{text:'to learn and'}
  ];

  function build(){
    C.innerHTML = '';
    allBlocks = [];
    lines.forEach(function(ln, li){
      var row = document.createElement('div');
      row.style.cssText = 'display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap;margin-bottom:2px;';
      ln.text.split(' ').forEach(function(word){
        var block = document.createElement('span');
        block.textContent = word;
        block.style.cssText = 'display:inline-block;padding:3px 10px;border-radius:4px;font-family:"Orbitron","Share Tech Mono",monospace;font-weight:700;font-size:clamp(15px,1.8vw,22px);color:#fff;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);letter-spacing:1px;opacity:0;transform:translateY(40px) rotate(-15deg) scale(0.6);transition:all 0.45s cubic-bezier(0.34,1.56,0.64,1);';
        row.appendChild(block);
        allBlocks.push({el:block, delay:0.08*allBlocks.length+li*0.15});
      });
      C.appendChild(row);
    });
    /* Change The World — each letter separate */
    var cwLine = document.createElement('div');
    cwLine.id = 'cw-line';
    cwLine.style.cssText = 'display:flex;gap:0;justify-content:flex-end;align-items:center;flex-wrap:wrap;margin-top:8px;cursor:pointer;';
    var t = 'Change The World';
    for(var i=0;i<t.length;i++){
      if(t[i]===' '){var sp=document.createElement('span');sp.style.cssText='display:inline-block;width:10px;';cwLine.appendChild(sp);continue;}
      var s=document.createElement('span');
      s.textContent=t[i];s.className='cl';
      s.style.cssText='display:inline-block;font-family:"Audiowide",cursive;font-size:clamp(18px,2.8vw,38px);font-weight:400;opacity:0;transform:translateX(-30px) scale(0.3);transition:none;letter-spacing:1px;';
      cwLine.appendChild(s);
    }
    C.appendChild(cwLine);
  }

  function enter(){
    allBlocks.forEach(function(b){
      setTimeout(function(){b.el.style.opacity='1';b.el.style.transform='translateY(0) rotate(0deg) scale(1)';}, b.delay*1000);
    });
    var cls = document.querySelectorAll('.cl');
    cls.forEach(function(el,i){
      var hue=200+i*22;
      el.style.color='hsl('+hue+',80%,60%)';
      el.style.textShadow='0 0 8px hsl('+hue+',80%,60%),0 0 25px hsl('+hue+',80%,60%),0 2px 4px rgba(0,0,0,0.3)';
      setTimeout(function(){
        el.style.transition='all 0.35s cubic-bezier(0.34,1.56,0.64,1)';
        el.style.opacity='1';el.style.transform='translateX(0) scale(1)';
        setTimeout(function(){lb(el,0);},250);
      }, 900+i*40);
    });
    var m=0;allBlocks.forEach(function(b){var d=b.delay*1000+500;if(d>m)m=d;});
    setTimeout(startIdle, m+1200);
  }

  function lb(el,n){
    if(n>5)return;
    var h=[18,13,9,6,3];
    setTimeout(function(){
      el.style.transition='transform 0.08s cubic-bezier(0.25,0.1,0.25,1)';
      el.style.transform='translateY(-'+h[n]+'px)';
      setTimeout(function(){
        el.style.transition='transform 0.1s cubic-bezier(0.55,0,0.55,1.3)';
        el.style.transform='translateY(0)';
        setTimeout(function(){lb(el,n+1);},h[n]*12+30);
      },70);
    },15);
  }

  function startIdle(){
    if(bounceTimer)clearInterval(bounceTimer);
    bounceTimer=setInterval(function(){
      if(!hoverEnabled)return;
      allBlocks.forEach(function(b,i){
        if(b.el.classList.contains('cl'))return;
        setTimeout(function(){
          b.el.style.transition='transform 0.15s cubic-bezier(0.25,0.1,0.25,1)';
          b.el.style.transform='translateY(-5px) rotate(0deg) scale(1.03)';
          setTimeout(function(){
            b.el.style.transition='transform 0.2s cubic-bezier(0.55,0,0.55,1.3)';
            b.el.style.transform='translateY(0) rotate(0deg) scale(1)';
          },150);
        },i*25);
      });
    },5000);
  }

  document.addEventListener('mouseover',function(e){
    var cw=document.getElementById('cw-line');
    if(!cw||!cw.contains(e.target)||!hoverEnabled)return;
    cw.querySelectorAll('.cl').forEach(function(b,i){
      b.style.transition='transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94)';
      b.style.transform='translateX('+(i-1)*4+'px) translateY(-4px) scale(1.04)';
    });
  });
  document.addEventListener('mouseout',function(e){
    var cw=document.getElementById('cw-line');
    if(!cw||!cw.contains(e.target))return;
    cw.querySelectorAll('.cl').forEach(function(b,i){
      b.style.transition='transform 0.35s cubic-bezier(0.34,1.56,0.64,1)';
      setTimeout(function(){b.style.transform='scale(1) translateY(-3px)';setTimeout(function(){b.style.transform='translateY(0) scale(1)';},150);},i*40);
    });
  });

  C.addEventListener('click',function(e){
    var cw=document.getElementById('cw-line');
    if(!cw||!cw.contains(e.target))return;
    if(bounceTimer)clearInterval(bounceTimer);
    cw.querySelectorAll('.cl').forEach(function(b,i){
      b.style.transition='all 0.15s ease';b.style.opacity='0';b.style.transform='translateX(-30px) scale(0.3)';
      setTimeout(function(){
        b.style.transition='all 0.35s cubic-bezier(0.34,1.56,0.64,1)';
        b.style.opacity='1';b.style.transform='translateX(0) scale(1)';
        setTimeout(function(){lb(b,0);},300);
      },i*50);
    });
    setTimeout(startIdle,2000);
  });

  build();
  setTimeout(enter,400);
  document.addEventListener('astro:page-load',function(){
    if(bounceTimer)clearInterval(bounceTimer);
    build();
    setTimeout(enter,500);
  });
})();
</script>
<style>
.ts-wrap{position:fixed;top:84px;right:28px;z-index:999;user-select:none;pointer-events:none;}
.tb{pointer-events:auto;position:relative;}
.cl{will-change:transform,opacity;}
@media(max-width:640px){
  .ts-wrap{top:76px;right:12px;}
  .tb{font-size:11px!important;padding:2px 6px!important;}
  .cl{font-size:14px!important;}
}
</style>
