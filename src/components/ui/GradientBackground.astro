<div class="starry-bg" aria-hidden="true">
  <div class="stars" id="stars"></div>
  <div class="shooting-stars" id="shooting-stars"></div>
  <div class="bg-glow"></div>
</div>

<script>
(function(){
  var container = document.getElementById('stars');
  if(!container) return;
  for(var i=0;i<200;i++){
    var star = document.createElement('div');
    var size = 0.5 + Math.random()*2;
    var x = Math.random()*100;
    var y = Math.random()*100;
    var delay = Math.random()*5;
    var dur = 2 + Math.random()*3;
    star.style.cssText = 'position:absolute;left:'+x+'%;top:'+y+'%;width:'+size+'px;height:'+size+'px;border-radius:50%;background:rgba(255,255,255,0.6);opacity:0;animation:twinkle '+dur+'s ease-in-out '+delay+'s infinite;';
    container.appendChild(star);
  }

  /* Shooting stars */
  var ss = document.getElementById('shooting-stars');
  if(ss){
    for(var j=0;j<3;j++){
      var s = document.createElement('div');
      s.className = 'shoot';
      s.style.cssText = 'position:absolute;width:2px;height:2px;border-radius:50%;background:#fff;opacity:0;';
      s.style.left = (10+Math.random()*80)+'%';
      s.style.top = (5+Math.random()*30)+'%';
      s.style.animation = 'shoot '+(3+Math.random()*4)+'s ease-out '+(5+Math.random()*10)+'s infinite';
      ss.appendChild(s);
    }
  }
})();
</script>

<style>
.starry-bg {
  position: fixed; inset: 0; z-index: -15;
  background: #08080e;
  overflow: hidden;
}

@keyframes twinkle {
  0%,100% { opacity: 0; transform: scale(0.5); }
  50% { opacity: 1; transform: scale(1); }
}

@keyframes shoot {
  0% { opacity: 0; transform: translate(0,0); }
  10% { opacity: 1; }
  40% { opacity: 1; }
  100% { opacity: 0; transform: translate(120px,120px); box-shadow: 0 0 20px 4px rgba(255,255,255,0.3); }
}

.bg-glow {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 80% 50% at 20% 30%, rgba(102,217,237,0.03), transparent 60%),
    radial-gradient(ellipse 60% 60% at 80% 70%, rgba(227,27,109,0.02), transparent 60%);
  pointer-events: none;
}
</style>
