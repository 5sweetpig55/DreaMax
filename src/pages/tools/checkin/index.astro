    {word:'thereby',meaning:'因此;从而',coll:'thereby doing',s:'The new law reduced costs, thereby increasing profits.'},
    {word:'thorough',meaning:'彻底的;全面的;仔细的',coll:'thorough investigation/search',s:'The police conducted a thorough investigation.',syn:'comprehensive [反] careless'},
    {word:'tolerance',meaning:'容忍;宽容;忍耐',coll:'tolerance of/for',s:'We should show tolerance towards others.',syn:'patience [反] intolerance'},
    {word:'transform',meaning:'转变;改造;变革',coll:'transform into',s:'The city has been transformed.',syn:'change [反] preserve'},
    {word:'transparent',meaning:'透明的;清晰的',coll:'transparent process/system',s:'The company should be more transparent.',syn:'clear [反] opaque'},
