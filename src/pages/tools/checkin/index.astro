    {word:'tangible',meaning:'有形的;可触摸的;明确的',coll:'tangible evidence/results',s:'We need tangible proof.',syn:'concrete [反] intangible'},
    {word:'temporary',meaning:'暂时的;临时的',coll:'temporary solution/job',s:'This is a temporary solution.',syn:'interim [反] permanent'},
