---
import PageLayout from "../../../layouts/PageLayout.astro";
---

<PageLayout title="DreaMax 自律打卡">
  <section class="min-h-screen px-6 pt-32 pb-24">
    <div class="mx-auto" style="max-width:860px;">
      <a href="/tools" class="font-mono text-sm link-underline" style="color:rgba(255,255,255,0.4);">&larr; Back to Tools</a>

      <!-- Login Gate -->
      <div id="login-gate" style="margin-top:60px;text-align:center;">
        <div style="display:inline-block;padding:40px;border:1px solid rgba(255,255,255,0.06);border-radius:16px;background:rgba(255,255,255,0.02);min-width:320px;">
          <div class="font-sans text-xl font-semibold text-white">自律打卡器</div>
          <div class="font-mono text-xs" style="color:rgba(255,255,255,0.25);margin-bottom:20px;">登录后使用</div>
          <input type="text" id="login-name" placeholder="用户名" style="width:100%;padding:10px 14px;border-radius:8px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.04);color:#fff;font-family:'JetBrains Mono',monospace;font-size:14px;outline:none;box-sizing:border-box;margin-bottom:12px;" />
          <input type="password" id="login-pwd" placeholder="密码" style="width:100%;padding:10px 14px;border-radius:8px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.04);color:#fff;font-family:'JetBrains Mono',monospace;font-size:14px;outline:none;box-sizing:border-box;margin-bottom:20px;" />
          <button id="btn-login" class="btn btn-pink" style="width:100%;padding:12px 0;justify-content:center;">进入</button>
          <div id="login-err" class="font-mono text-xs" style="color:#e31b6d;margin-top:8px;display:none;">用户名或密码错误</div>
          <div class="font-mono text-xs" style="color:rgba(255,255,255,0.15);margin-top:16px;">管理员: admin / 123456 &nbsp;|&nbsp; 用户自行注册</div>
          <button id="btn-register" class="btn btn-ghost" style="margin-top:8px;padding:6px 16px;font-size:11px;">注册新账号</button>
        </div>
      </div>

      <!-- Main App -->
      <div id="main-app" style="display:none;">
        <div class="flex items-center justify-between" style="margin-bottom:8px;">
          <h1 class="section-heading" style="margin:0;">
            <span class="accent-bar" style="background:#e31b6d;"></span>自律打卡器
          </h1>
          <span id="current-user" class="font-mono text-xs" style="color:rgba(255,255,255,0.25);"></span>
        </div>
        <p class="font-mono text-sm" style="color:rgba(255,255,255,0.4);">每日记录 英语学习 自我管理</p>

        <div class="flex gap-2" style="margin-top:28px;border-bottom:1px solid rgba(255,255,255,0.06);">
          <button class="tab-b active" data-tab="checkin">打卡</button>
          <button class="tab-b" data-tab="words">单词</button>
          <button class="tab-b" data-tab="history">记录</button>
          <button class="tab-b admin-only" data-tab="admin" id="admin-tab" style="display:none;">管理</button>
        </div>

        <!-- Tab: Checkin -->
        <div id="tab-checkin" class="tab-c" style="margin-top:24px;">
          <div class="flex flex-col md:flex-row gap-6">
            <div class="flex-1 p-6" style="border:1px solid rgba(255,255,255,0.06);border-radius:14px;background:rgba(255,255,255,0.02);">
              <div class="font-mono text-xs" style="color:rgba(255,255,255,0.25);">今日状态</div>
              <div id="streak-display" class="font-sans text-2xl font-bold" style="margin-top:8px;color:#66d9ed;">--</div>
              <div id="msg-display" class="font-mono text-sm" style="margin-top:8px;color:rgba(255,255,255,0.5);line-height:1.6;min-height:60px;">加载中...</div>
              <div style="margin-top:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.04);">
                <div class="font-mono text-xs" style="color:rgba(255,255,255,0.25);margin-bottom:10px;">今天做了吗？</div>
                <div class="flex gap-3">
                  <button id="btn-yes" class="btn btn-pink" style="padding:10px 24px;font-size:13px;">做了</button>
                  <button id="btn-no" class="btn btn-ghost" style="padding:10px 24px;font-size:13px;">没有</button>
                </div>
                <div id="count-area" style="display:none;margin-top:12px;">
                  <div class="font-mono text-xs" style="color:rgba(255,255,255,0.25);margin-bottom:6px;">做了几次？</div>
                  <div class="flex gap-2">
                    <button class="cnt-btn" data-n="1">1次</button>
                    <button class="cnt-btn" data-n="2">2次</button>
                    <button class="cnt-btn" data-n="3">3次</button>
                    <button class="cnt-btn" data-n="4">4+次</button>
                  </div>
                </div>
              </div>
            </div>
            <div class="flex-1 p-6" style="border:1px solid rgba(255,255,255,0.06);border-radius:14px;background:rgba(255,255,255,0.02);">
              <div class="font-mono text-xs" style="color:rgba(255,255,255,0.25);">本周统计</div>
              <div id="week-stats" style="margin-top:12px;">
                <div class="flex justify-between py-2" style="border-bottom:1px solid rgba(255,255,255,0.04);">
                  <span class="font-mono text-xs" style="color:rgba(255,255,255,0.3);">本周打卡</span>
                  <span id="week-count" class="font-mono text-sm" style="color:rgba(255,255,255,0.6);">0天</span>
                </div>
                <div class="flex justify-between py-2" style="border-bottom:1px solid rgba(255,255,255,0.04);">
                  <span class="font-mono text-xs" style="color:rgba(255,255,255,0.3);">本月记录</span>
                  <span id="month-count" class="font-mono text-sm" style="color:rgba(255,255,255,0.6);">0天</span>
                </div>
                <div class="flex justify-between py-2" style="border-bottom:1px solid rgba(255,255,255,0.04);">
                  <span class="font-mono text-xs" style="color:rgba(255,255,255,0.3);">最高连续</span>
                  <span id="best-streak" class="font-mono text-sm" style="color:#66d9ed;">0天</span>
                </div>
                <div class="flex justify-between py-2">
                  <span class="font-mono text-xs" style="color:rgba(255,255,255,0.3);">当前连续</span>
                  <span id="cur-streak" class="font-mono text-sm" style="color:#e31b6d;">0天</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab: Words -->
        <div id="tab-words" class="tab-c" style="display:none;margin-top:24px;">
          <div class="flex items-center justify-between mb-4" style="border-bottom:1px solid rgba(255,255,255,0.04);padding-bottom:12px;">
            <div>
              <span class="font-mono text-xs" style="color:rgba(255,255,255,0.25);">今日单词</span>
              <span class="font-mono text-xs" style="color:#e31b6d;margin-left:12px;">今天忍不住了吗？来背单词！</span>
            </div>
            <div class="flex gap-2">
              <span id="word-progress" class="font-mono text-xs" style="color:rgba(255,255,255,0.2);padding:4px 0;">0/10</span>
              <button id="btn-word-prev" class="btn btn-ghost" style="padding:4px 10px;font-size:10px;">←</button>
              <button id="btn-word-next" class="btn btn-ghost" style="padding:4px 10px;font-size:10px;">→</button>
            </div>
          </div>
          <div id="word-card" class="p-6" style="border:1px solid rgba(255,255,255,0.06);border-radius:14px;background:rgba(255,255,255,0.02);min-height:320px;">
            <div id="word-question">
              <div class="font-mono text-xs" style="color:rgba(255,255,255,0.2);margin-bottom:8px;"></div>
              <div id="word-en" class="font-sans text-xl font-semibold text-white"></div>
              <div id="word-options" class="flex flex-col gap-2" style="margin-top:16px;"></div>
            </div>
            <div id="word-answer" style="display:none;margin-top:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.04);">
              <div id="word-result" class="font-mono text-sm" style="margin-bottom:12px;"></div>
              <div id="word-detail" style="padding:14px;border-radius:8px;background:rgba(102,217,237,0.04);">
                <div class="font-mono text-xs" style="color:#66d9ed;margin-bottom:6px;">详细解析</div>
                <div id="word-meaning" class="text-sm" style="color:rgba(255,255,255,0.6);line-height:1.7;"></div>
                <div id="word-collocations" class="text-sm" style="color:rgba(255,255,255,0.6);margin-top:6px;line-height:1.7;"></div>
                <div id="word-sentence" class="text-sm" style="color:rgba(255,255,255,0.5);margin-top:6px;line-height:1.7;font-style:italic;"></div>
                <div id="word-tip" class="text-sm" style="color:#e31b6d;margin-top:6px;line-height:1.6;"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab: History -->
        <div id="tab-history" class="tab-c" style="display:none;margin-top:24px;">
          <div class="flex items-center justify-between mb-4">
            <span class="font-mono text-xs" style="color:rgba(255,255,255,0.25);">全部打卡记录</span>
          </div>
          <div id="history-list" style="display:flex;flex-direction:column;gap:4px;"></div>
        </div>

        <!-- Tab: Admin -->
        <div id="tab-admin" class="tab-c" style="display:none;margin-top:24px;">
          <div class="font-mono text-xs" style="color:#66d9ed;margin-bottom:16px;">所有用户打卡记录</div>
          <div id="admin-list"></div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script>
(function(){
  var SUPABASE_URL = 'https://bunumbcdivevvtjvsuvk.supabase.co';
  var SUPABASE_KEY = 'sb_publishable_JIUEsQjSI-n2G5rBFeJDAA_jE48im34';

  var USER_KEY = 'dreamax_checkin_user';
  var ADMIN_USERS = ['admin','dreamax'];

  var loggedUser = sessionStorage.getItem(USER_KEY);
  var db = null;

  function supabaseFetch(path, opts){
    return fetch(SUPABASE_URL + '/rest/v1/' + path, {
      headers: {
        'apikey': SUPABASE_KEY,
        'Authorization': 'Bearer ' + SUPABASE_KEY,
        'Content-Type': 'application/json',
        'Prefer': 'return=representation',
        ...(opts && opts.headers || {})
      },
      ...(opts || {})
    });
  }

  if(loggedUser) initApp();

  document.getElementById('btn-login').addEventListener('click', login);
  document.getElementById('login-name').addEventListener('keydown', function(e){ if(e.key==='Enter') login(); });
  document.getElementById('login-pwd').addEventListener('keydown', function(e){ if(e.key==='Enter') login(); });

  function login(){
    var name = document.getElementById('login-name').value.trim();
    var pwd = document.getElementById('login-pwd').value.trim();
    var users = { admin:'123456', dreamax:'dreamax520' };
    if(users[name] && users[name]===pwd){
      sessionStorage.setItem(USER_KEY, name);
      loggedUser = name;
      document.getElementById('login-gate').style.display = 'none';
      document.getElementById('main-app').style.display = 'block';
      initApp();
    } else {
      document.getElementById('login-err').style.display = 'block';
    }
  }

  document.getElementById('btn-register').addEventListener('click', function(){
    var name = prompt('请输入新用户名:');
    if(!name) return;
    var pwd = prompt('请输入密码:');
    if(!pwd) return;
    sessionStorage.setItem(USER_KEY, name);
    loggedUser = name;
    document.getElementById('login-gate').style.display = 'none';
    document.getElementById('main-app').style.display = 'block';
    initApp();
  });

  function isAdmin(){ return ADMIN_USERS.includes(loggedUser); }

  function initApp(){
    document.getElementById('current-user').textContent = loggedUser + (isAdmin() ? ' (管理员)' : '');
    if(isAdmin()) document.getElementById('admin-tab').style.display = '';
    loadCheckin();
  }

  function todayStr(){
    var d=new Date();
    return d.getFullYear()+'-'+(d.getMonth()+1).toString().padStart(2,'0')+'-'+d.getDate().toString().padStart(2,'0');
  }

  var cachedRecords = [];

  async function loadCheckin(){
    var q = '/checkin_records?order=date.asc';
    var res = await supabaseFetch(q);
    var all = await res.json() || [];
    cachedRecords = all;

    var myRecords = isAdmin() ? all : all.filter(function(r){ return r.username === loggedUser; });

    var today = todayStr();
    var todayRecords = myRecords.filter(function(r){ return r.date === today; });

    var streakCount = calcStreak(myRecords);
    var bestS = calcBestStreak(myRecords);
    var weekStart = getWeekStart();
    var monthStr = today.substring(0,7);

    document.getElementById('week-count').textContent = myRecords.filter(function(r){ return r.did && r.date >= weekStart; }).length + '天';
    document.getElementById('month-count').textContent = myRecords.filter(function(r){ return r.did && r.date.substring(0,7) === monthStr; }).length + '天';
    document.getElementById('best-streak').textContent = bestS + '天';
    document.getElementById('cur-streak').textContent = streakCount + '天';

    var streakEl = document.getElementById('streak-display');
    var msgEl = document.getElementById('msg-display');

    if(todayRecords.length > 0 && todayRecords[0].did){
      var n = todayRecords[0].count;
      streakEl.textContent = '今日已破戒 ('+n+'次)';
      streakEl.style.color = '#e31b6d';
      msgEl.innerHTML = SHAME_MSGS[Math.min(n,4)];
      if(streakCount>=7) msgEl.innerHTML += '<br>但你已经连续7天... 哦你破戒了？';
      else if(streakCount>=5) msgEl.innerHTML += '<br>连续5天的纪录就这么毁了...';
      else if(streakCount>=3) msgEl.innerHTML += '<br>连续3天的纪录没了，值得吗？';
    } else {
      streakEl.textContent = '今日平安';
      streakEl.style.color = '#66d9ed';
      if(streakCount>=7) msgEl.innerHTML = '连续7天！恭喜获得铁男称号，奖励自己一顿好的！<br><span style="color:#ff6b2b;">你已经超过了99%的男生！</span>';
      else if(streakCount>=5) msgEl.textContent = '连续5天！金刚不坏之身初成';
      else if(streakCount>=3) msgEl.textContent = '连续3天！元始天尊都为你点赞';
      else if(streakCount>=2) msgEl.textContent = '连续2天！你已经超过了全国50%的男生';
      else if(streakCount>0) msgEl.textContent = '好样的！今天又管住手了';
      else msgEl.textContent = '今天还没记录，加油少年！';
    }

    renderHistory(myRecords);
    if(isAdmin()) renderAdmin(all);
  }

  function calcStreak(records){
    var count=0;
    var d=new Date();
    while(true){
      var s=d.getFullYear()+'-'+(d.getMonth()+1).toString().padStart(2,'0')+'-'+d.getDate().toString().padStart(2,'0');
      var found=records.some(function(r){return r.date===s && r.did;});
      if(!found) break;
      count++;
      d.setDate(d.getDate()-1);
    }
    return count;
  }

  function calcBestStreak(records){
    var best=0,cur=0;
    var sorted=records.slice().sort(function(a,b){return a.date.localeCompare(b.date);});
    for(var i=0;i<sorted.length;i++){
      if(sorted[i].did){cur++;if(cur>best)best=cur;}
      else cur=0;
    }
    return best;
  }

  function getWeekStart(){
    var d=new Date(); var day=d.getDay();
    var diff=d.getDate()-day+(day===0?-6:1);
    var m=new Date(d.setDate(diff));
    return m.getFullYear()+'-'+(m.getMonth()+1).toString().padStart(2,'0')+'-'+m.getDate().toString().padStart(2,'0');
  }

  var SHAME_MSGS = [
    '你又破功了... 你的未来老婆正在扣分',
    '手都起茧了吧？心疼你未来对象三秒',
    '连续作战?! 你是想凭实力单身到老吗',
    '牛啊牛啊，这频率... 隔壁老王都自愧不如',
    '兄弟，再这样下去真的会找不到老婆的'
  ];

  /* Record actions */
  document.getElementById('btn-yes').addEventListener('click',function(){document.getElementById('count-area').style.display='block';});
  document.getElementById('btn-no').addEventListener('click',recordNo);
  document.querySelectorAll('.cnt-btn').forEach(function(b){b.addEventListener('click',function(){recordYes(parseInt(b.getAttribute('data-n')));});});

  async function recordNo(){
    var today = todayStr();
    var existing = cachedRecords.filter(function(r){ return r.date===today && r.username===loggedUser; });
    if(existing.length>0){
      await supabaseFetch('/checkin_records?id=eq.'+existing[0].id, { method:'DELETE' });
    }
    await supabaseFetch('/checkin_records', {
      method:'POST',
      body: JSON.stringify({username:loggedUser, date:today, did:false, count:0})
    });
    document.getElementById('count-area').style.display='none';
    loadCheckin();
  }

  async function recordYes(n){
    var today = todayStr();
    var existing = cachedRecords.filter(function(r){ return r.date===today && r.username===loggedUser; });
    if(existing.length>0){
      await supabaseFetch('/checkin_records?id=eq.'+existing[0].id, { method:'DELETE' });
    }
    await supabaseFetch('/checkin_records', {
      method:'POST',
      body: JSON.stringify({username:loggedUser, date:today, did:true, count:n})
    });
    document.getElementById('count-area').style.display='none';
    loadCheckin();
  }

  function renderHistory(records){
    var list=document.getElementById('history-list');
    if(records.length===0){list.innerHTML='<div class="font-mono text-sm" style="color:rgba(255,255,255,0.2);text-align:center;padding:40px 0;">暂无记录</div>';return;}
    var sorted=records.slice().sort(function(a,b){return b.date.localeCompare(a.date);});
    list.innerHTML = sorted.map(function(r){
      return '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 12px;border-radius:6px;background:'+(r.did?'rgba(227,27,109,0.04)':'rgba(102,217,237,0.03)')+';">'+
        '<span style="display:flex;align-items:center;gap:8px;"><span class="font-mono text-sm" style="color:rgba(255,255,255,0.5);">'+r.date+'</span><span class="font-mono text-xs" style="color:rgba(255,255,255,0.15);">'+r.username+'</span></span>'+
        (r.did?'<span class="font-mono text-xs" style="color:#e31b6d;">破戒 '+r.count+'次</span>':'<span class="font-mono text-xs" style="color:#66d9ed;">平安</span>')+
      '</div>';
    }).join('');
  }

  function renderAdmin(all){
    var list=document.getElementById('admin-list');
    var users={};
    all.forEach(function(r){
      if(!users[r.username]) users[r.username]={records:[]};
      users[r.username].records.push(r);
    });
    var html='<div style="display:flex;flex-direction:column;gap:12px;">';
    Object.keys(users).forEach(function(u){
      var recs=users[u].records;
      var didCount=recs.filter(function(r){return r.did;}).length;
      var streak=calcStreak(recs);
      var best=calcBestStreak(recs);
      html += '<div style="padding:14px;border:1px solid rgba(255,255,255,0.06);border-radius:10px;">';
      html += '<div class="flex items-center gap-3 mb-2"><span class="font-sans font-semibold text-white">'+u+'</span><span class="font-mono text-xs" style="color:rgba(255,255,255,0.25);">共'+recs.length+'天记录</span></div>';
      html += '<div style="display:flex;gap:16px;font-family:JetBrains Mono,monospace;font-size:12px;">';
      html += '<span style="color:#e31b6d;">破戒 '+didCount+'天</span>';
      html += '<span style="color:#66d9ed;">平安 '+(recs.length-didCount)+'天</span>';
      html += '<span style="color:rgba(255,255,255,0.4);">当前连续 '+streak+'天</span>';
      html += '<span style="color:rgba(255,255,255,0.4);">最长 '+best+'天</span>';
      html += '</div></div>';
    });
    html+='</div>';
    list.innerHTML=html;
  }

  /* ── Tabs ── */
  document.querySelectorAll('.tab-b').forEach(function(t){
    t.addEventListener('click',function(){
      document.querySelectorAll('.tab-b').forEach(function(x){x.className='tab-b';x.style.background='transparent';x.style.color='rgba(255,255,255,0.4)';});
      t.className='tab-b active';t.style.background='rgba(102,217,237,0.08)';t.style.color='#66d9ed';
      document.querySelectorAll('.tab-c').forEach(function(c){c.style.display='none';});
      var tab = document.getElementById('tab-'+t.getAttribute('data-tab'));
      if(tab) tab.style.display='block';
      if(t.getAttribute('data-tab')==='words') loadWords();
    });
  });

  /* ── VOCABULARY CET-6 / GRE Level ── */
  var VOCAB = [
    {word:'abstain',meaning:'弃权;戒除',coll:'abstain from voting/alcohol',s:'He abstained from voting on the proposal.',usage:'abstain from + noun/doing'},
    {word:'absurd',meaning:'荒谬的;可笑的',coll:'absurd idea/suggestion',s:'The idea that the earth is flat is absurd.',syn:'ridiculous, preposterous [反] reasonable'},
    {word:'abundance',meaning:'丰富;充裕',coll:'abundance of sth',s:'There is an abundance of evidence.',syn:'plenty, affluence [反] scarcity, shortage'},
    {word:'accelerate',meaning:'加速;促进',coll:'accelerate growth/pace',s:'Economic growth accelerated this quarter.',tip:'名词 acceleration；反义词 decelerate'},
    {word:'accommodate',meaning:'容纳;适应;提供住宿',coll:'accommodate sb; accommodate to',s:'The hotel can accommodate 500 guests.',tip:'accommodate sb with sth = 提供某物给某人'},
    {word:'accountable',meaning:'负有责任的',coll:'accountable to/for',s:'Managers are accountable to shareholders.',syn:'responsible, answerable [反] irresponsible'},
    {word:'accumulate',meaning:'积累;积聚',coll:'accumulate wealth/experience',s:'Dust accumulated on the shelves.',syn:'amass, build up [反] dissipate, scatter'},
    {word:'acknowledge',meaning:'承认;确认',coll:'acknowledge receipt of; acknowledge that',s:'He acknowledged having made a mistake.',tip:'acknowledge + doing / that 从句'},
    {word:'acquisition',meaning:'获得;收购',coll:'acquisition of knowledge; merger and acquisition',s:'The company made a major acquisition.',tip:'动词 acquire；M&A = mergers and acquisitions'},
