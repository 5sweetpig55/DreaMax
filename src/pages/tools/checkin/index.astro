  /* ── Bind actions (runs after login) ── */
  function bindActions(){
    document.querySelectorAll('.action-btn').forEach(function(b){
      b.addEventListener('click',function(){
        var act=b.getAttribute('data-action');
        if(act==='yes'){document.getElementById('count-area').style.display='block';}
        else if(act==='no'){recordAction(false,0);}
      });
    });
    document.querySelectorAll('.cnt-btn').forEach(function(b){
      b.addEventListener('click',function(){recordAction(true,parseInt(b.getAttribute('data-n')));});
    });
    document.querySelectorAll('.word-nav').forEach(function(b){
      b.addEventListener('click',function(){
        var d=b.getAttribute('data-dir');
        if(d==='prev'&&wordIdx>0)showWord(wordIdx-1);
        if(d==='next'&&wordIdx<wordList.length-1)showWord(wordIdx+1);
      });
    });
  }

  async function recordAction(did,count){
    var today=todayStr();
    /* Delete existing today record */
    var existing=cachedRecords.filter(function(r){return r.date===today&&r.username===loggedUser;});
    for(var i=0;i<existing.length;i++){
      await supabaseFetch('/checkin_records?id=eq.'+existing[i].id,{method:'DELETE'});
    }
    await supabaseFetch('/checkin_records',{
      method:'POST',
      body:JSON.stringify({username:loggedUser,date:today,did:did,count:count})
    });
    document.getElementById('count-area').style.display='none';
    loadData();
  }

  /* ── Tabs ── */
  document.querySelectorAll('.tab-b').forEach(function(t){
    t.addEventListener('click',function(){
      document.querySelectorAll('.tab-b').forEach(function(x){x.className='tab-b';x.style.background='transparent';x.style.color='rgba(255,255,255,0.4)';});
      t.className='tab-b active';t.style.background='rgba(102,217,237,0.08)';t.style.color='#66d9ed';
      document.querySelectorAll('.tab-c').forEach(function(c){c.style.display='none';});
      var tab=document.getElementById('tab-'+t.getAttribute('data-tab'));
      if(tab) tab.style.display='block';
      if(t.getAttribute('data-tab')==='words') loadWords();
    });
  });

