  var wordIdx=0, wordList=[];
  function loadWords(){
    var sh=VOCAB.slice().sort(function(){return Math.random()-0.5;});
    wordList=sh.slice(0,10);
    wordIdx=0;
    showWord(0);
  }

  function showWord(idx){
    if(!wordList||wordList.length===0)return;
    if(idx>=wordList.length)idx=wordList.length-1;if(idx<0)idx=0;wordIdx=idx;
    var w=wordList[idx];
    document.getElementById('word-en').textContent=w.word;
    document.getElementById('word-progress').textContent=(idx+1)+'/'+wordList.length;

    var opts=[w.meaning];
    var all=VOCAB.map(function(v){return v.meaning;}).filter(function(m){return m!==w.meaning;});
    for(var i=0;i<3;i++){var p=all[Math.floor(Math.random()*all.length)];if(!opts.includes(p))opts.push(p);else i--;}
    opts.sort(function(){return Math.random()-0.5;});

    var html='';
    opts.forEach(function(o){html+='<div class="opti" data-ans="'+(o===w.meaning?'1':'0')+'" style="padding:11px 14px;border-radius:8px;border:1px solid rgba(255,255,255,0.06);cursor:pointer;color:rgba(255,255,255,0.6);font-size:14px;">'+o+'</div>';});
    document.getElementById('word-options').innerHTML=html;
    document.getElementById('word-question').style.display='block';
    document.getElementById('word-answer').style.display='none';

    var ans=false;
    document.querySelectorAll('.opti').forEach(function(el){
      el.addEventListener('click',function(){
        if(ans)return;ans=true;
        var correct=el.getAttribute('data-ans')==='1';
        var r=document.getElementById('word-result');
        if(correct){el.style.borderColor='#66d9ed';el.style.background='rgba(102,217,237,0.08)';r.innerHTML='<span style="color:#66d9ed;">正确!</span>';}
        else{
          el.style.borderColor='#e31b6d';el.style.background='rgba(227,27,109,0.08)';
          document.querySelectorAll('.opti').forEach(function(e){if(e.getAttribute('data-ans')==='1'){e.style.borderColor='#66d9ed';e.style.background='rgba(102,217,237,0.08)';}});
          r.innerHTML='<span style="color:#e31b6d;">错误</span>';
        }
        document.getElementById('word-meaning').innerHTML='<strong>释义:</strong> '+w.meaning;
        document.getElementById('word-collocations').innerHTML='<strong>搭配:</strong> '+w.coll+'<br><strong>用法:</strong> '+w.tip;
        document.getElementById('word-sentence').innerHTML='<strong>例句:</strong> '+w.s;
        document.getElementById('word-tip').innerHTML=w.syn?'<strong>辨析:</strong> '+w.syn:'<strong>提示:</strong> 注意固定搭配';
        document.getElementById('word-question').style.display='none';
        document.getElementById('word-answer').style.display='block';
      });
    });
  }
})();
</script>

