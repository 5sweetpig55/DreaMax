---
import PageLayout from "../../../layouts/PageLayout.astro";
---

<PageLayout title="DreaMax 自律打卡">
  <section class="min-h-screen px-6 pt-32 pb-24">
    <div class="mx-auto" style="max-width:860px;">
      <a href="/tools" class="font-mono text-sm link-underline" style="color:rgba(255,255,255,0.4);">&larr; Back to Tools</a>

      <!-- Login Gate -->
      <div id="login-gate" style="margin-top:60px;text-align:center;">
        <div style="display:inline-block;padding:40px;border:1px solid rgba(255,255,255,0.06);border-radius:16px;background:rgba(255,255,255,0.02);min-width:320px;">
          <div class="font-sans text-xl font-semibold text-white">自律打卡器</div>
          <div class="font-mono text-xs" style="color:rgba(255,255,255,0.25);margin-bottom:20px;">登录后使用</div>
          <input type="text" id="login-name" placeholder="用户名" style="width:100%;padding:10px 14px;border-radius:8px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.04);color:#fff;font-family:'JetBrains Mono',monospace;font-size:14px;outline:none;box-sizing:border-box;margin-bottom:12px;" />
          <input type="password" id="login-pwd" placeholder="密码" style="width:100%;padding:10px 14px;border-radius:8px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.04);color:#fff;font-family:'JetBrains Mono',monospace;font-size:14px;outline:none;box-sizing:border-box;margin-bottom:20px;" />
          <button id="btn-login" class="btn btn-pink" style="width:100%;padding:12px 0;justify-content:center;">进入</button>
          <div id="login-err" class="font-mono text-xs" style="color:#e31b6d;margin-top:8px;display:none;">用户名或密码错误</div>
          <div class="font-mono text-xs" style="color:rgba(255,255,255,0.15);margin-top:16px;">输入名字和密码即可登录，首次使用自动注册</div>
          <button id="btn-register" class="btn btn-ghost" style="margin-top:8px;padding:6px 16px;font-size:11px;">注册新账号</button>
        </div>
      </div>

      <!-- Main App -->
      <div id="main-app" style="display:none;">
        <div class="flex items-center justify-between" style="margin-bottom:8px;">
          <h1 class="section-heading" style="margin:0;"><span class="accent-bar" style="background:#e31b6d;"></span>自律打卡器</h1>
          <span id="current-user" class="font-mono text-xs" style="color:rgba(255,255,255,0.25);"></span>
        </div>
        <p class="font-mono text-sm" style="color:rgba(255,255,255,0.4);">每日记录 · 英语学习 · 自我管理</p>

        <div class="flex gap-2" style="margin-top:28px;border-bottom:1px solid rgba(255,255,255,0.06);">
          <button class="tab-b active" data-tab="checkin">打卡</button>
          <button class="tab-b" data-tab="words">单词</button>
          <button class="tab-b" data-tab="history">记录</button>
          <button class="tab-b admin-only" data-tab="admin" id="admin-tab" style="display:none;">管理</button>
        </div>

        <!-- Tab: Checkin -->
        <div id="tab-checkin" class="tab-c" style="margin-top:24px;">
          <div class="flex flex-col md:flex-row gap-6">
            <div class="flex-1 p-6" style="border:1px solid rgba(255,255,255,0.06);border-radius:14px;background:rgba(255,255,255,0.02);">
              <div class="font-mono text-xs" style="color:rgba(255,255,255,0.25);">今日状态</div>
              <div id="streak-display" class="font-sans text-xl font-bold" style="margin-top:8px;color:#66d9ed;">--</div>
              <div id="msg-display" class="font-mono text-sm" style="margin-top:8px;color:rgba(255,255,255,0.5);line-height:1.7;min-height:70px;">加载中...</div>
              <div style="margin-top:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.04);">
                <div class="font-mono text-xs" style="color:rgba(255,255,255,0.25);margin-bottom:10px;">今天做了吗？</div>
                <div class="flex gap-3">
                  <button class="btn btn-pink action-btn" data-action="yes" style="padding:10px 24px;font-size:13px;">做了</button>
                  <button class="btn btn-ghost action-btn" data-action="no" style="padding:10px 24px;font-size:13px;">没有</button>
                </div>
                <div id="count-area" style="display:none;margin-top:12px;">
                  <div class="font-mono text-xs" style="color:rgba(255,255,255,0.25);margin-bottom:6px;">今天第几次？</div>
                  <div class="flex gap-2 flex-wrap">
                    <button class="cnt-btn" data-n="1">第1次</button>
                    <button class="cnt-btn" data-n="2">第2次</button>
                    <button class="cnt-btn" data-n="3">第3次</button>
                    <button class="cnt-btn" data-n="4">第4次</button>
                    <button class="cnt-btn" data-n="5">第5次+</button>
                  </div>
                </div>
              </div>
            </div>
            <div class="flex-1 p-6" style="border:1px solid rgba(255,255,255,0.06);border-radius:14px;background:rgba(255,255,255,0.02);">
              <div class="font-mono text-xs" style="color:rgba(255,255,255,0.25);">本周统计</div>
              <div style="margin-top:12px;">
                <div class="flex justify-between py-2" style="border-bottom:1px solid rgba(255,255,255,0.04);">
                  <span class="font-mono text-xs" style="color:rgba(255,255,255,0.3);">本周打卡</span>
                  <span id="week-count" class="font-mono text-sm" style="color:rgba(255,255,255,0.6);">0天</span>
                </div>
                <div class="flex justify-between py-2" style="border-bottom:1px solid rgba(255,255,255,0.04);">
                  <span class="font-mono text-xs" style="color:rgba(255,255,255,0.3);">本月记录</span>
                  <span id="month-count" class="font-mono text-sm" style="color:rgba(255,255,255,0.6);">0天</span>
                </div>
                <div class="flex justify-between py-2" style="border-bottom:1px solid rgba(255,255,255,0.04);">
                  <span class="font-mono text-xs" style="color:rgba(255,255,255,0.3);">当前连续</span>
                  <span id="cur-streak" class="font-mono text-sm" style="color:#66d9ed;">0天</span>
                </div>
                <div class="flex justify-between py-2">
                  <span class="font-mono text-xs" style="color:rgba(255,255,255,0.3);">最长连续</span>
                  <span id="best-streak" class="font-mono text-sm" style="color:#e31b6d;">0天</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab: Words -->
        <div id="tab-words" class="tab-c" style="display:none;margin-top:24px;">
          <div class="flex items-center justify-between mb-4" style="border-bottom:1px solid rgba(255,255,255,0.04);padding-bottom:12px;">
            <div>
              <span class="font-mono text-xs" style="color:rgba(255,255,255,0.25);">六级词汇</span>
              <span class="font-mono text-xs" style="color:#e31b6d;margin-left:12px;">今天忍不住了吗？来背单词！</span>
            </div>
            <div class="flex gap-2">
              <span id="word-progress" class="font-mono text-xs" style="color:rgba(255,255,255,0.2);padding:4px 0;">0/10</span>
              <button class="btn btn-ghost word-nav" data-dir="prev" style="padding:4px 10px;font-size:10px;">←</button>
              <button class="btn btn-ghost word-nav" data-dir="next" style="padding:4px 10px;font-size:10px;">→</button>
            </div>
          </div>
          <div id="word-card" class="p-6" style="border:1px solid rgba(255,255,255,0.06);border-radius:14px;background:rgba(255,255,255,0.02);min-height:320px;">
            <div id="word-question">
              <div id="word-en" class="font-sans text-xl font-semibold text-white"></div>
              <div id="word-options" class="flex flex-col gap-2" style="margin-top:16px;"></div>
            </div>
            <div id="word-answer" style="display:none;margin-top:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.04);">
              <div id="word-result" class="font-mono text-sm" style="margin-bottom:12px;"></div>
              <div id="word-detail" style="padding:14px;border-radius:8px;background:rgba(102,217,237,0.04);">
                <div class="font-mono text-xs" style="color:#66d9ed;margin-bottom:6px;">详细解析</div>
                <div id="word-meaning" class="text-sm" style="color:rgba(255,255,255,0.6);line-height:1.7;"></div>
                <div id="word-collocations" class="text-sm" style="color:rgba(255,255,255,0.6);margin-top:6px;line-height:1.7;"></div>
                <div id="word-sentence" class="text-sm" style="color:rgba(255,255,255,0.5);margin-top:6px;line-height:1.7;font-style:italic;"></div>
                <div id="word-tip" class="text-sm" style="color:#e31b6d;margin-top:6px;line-height:1.6;"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab: History -->
        <div id="tab-history" class="tab-c" style="display:none;margin-top:24px;">
          <div class="font-mono text-xs" style="color:rgba(255,255,255,0.25);margin-bottom:12px;">打卡记录表</div>
          <div id="history-table-wrap" style="overflow-x:auto;"></div>
        </div>

        <!-- Tab: Admin -->
        <div id="tab-admin" class="tab-c" style="display:none;margin-top:24px;">
          <div class="font-mono text-xs" style="color:#66d9ed;margin-bottom:16px;">所有用户完整记录</div>
          <div id="admin-list"></div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script>
(function(){
  var SUPABASE_URL = 'https://bunumbcdivevvtjvsuvk.supabase.co';
  var SUPABASE_KEY = 'sb_publishable_JIUEsQjSI-n2G5rBFeJDAA_jE48im34';
  var USER_KEY = 'dreamax_checkin_user';
  var ADMIN_USERS = ['admin','dreamax'];
  var loggedUser = sessionStorage.getItem(USER_KEY);
  var cachedRecords = [];
  var SHAME = [
    '你又破功了... 你的未来老婆正在扣分，分快扣没了！',
    '手都起茧了吧？心疼你未来对象三秒... 不对，一秒就够了',
    '连续作战？！你是想凭实力单身到老吗？',
    '牛啊牛啊，这频率... 你不怕以后交公粮交不出来吗？',
    '兄弟你这样真的不行，到时候女朋友都嫌弃你',
    '又来了？你这是要把自家兄弟累死啊！',
    '服了你了，你比生产队的驴还能干',
    '你是不是觉得自己很行？你不行！你很虚！',
    '我替你未来的老婆说一句：求你放过你自己！',
    '别人一天一次，你一天五次？你是在挑战吉尼斯吗？',
  ];
  var ENC = [
    '好样的！今天又管住手了，你是真正的时间管理大师',
    '自律的男人最帅！继续保持，女神迟早是你的',
    '坚持住！今天没有破戒，奖励自己一杯奶茶',
    '很好！你正在变成更好的自己，你的未来对象很欣慰',
  ];

  supabaseFetch = function(path, opts){
    return fetch(SUPABASE_URL+'/rest/v1/'+path, {
      headers: {'apikey':SUPABASE_KEY,'Authorization':'Bearer '+SUPABASE_KEY,'Content-Type':'application/json','Prefer':'return=representation',...(opts&&opts.headers||{})},
      ...(opts||{})
    });
  };

  if(loggedUser) initApp();

  document.getElementById('btn-login').addEventListener('click',login);
  document.getElementById('login-name').addEventListener('keydown',function(e){if(e.key==='Enter')login();});
  document.getElementById('login-pwd').addEventListener('keydown',function(e){if(e.key==='Enter')login();});

  function login(){
    var name=document.getElementById('login-name').value.trim();
    var pwd=document.getElementById('login-pwd').value.trim();
    if(!name||!pwd){document.getElementById('login-err').textContent='请填写完整';document.getElementById('login-err').style.display='block';return;}
    sessionStorage.setItem(USER_KEY,name);loggedUser=name;
    document.getElementById('login-gate').style.display='none';
    document.getElementById('main-app').style.display='block';
    initApp();
  }

  document.getElementById('btn-register').addEventListener('click',function(){
    var name=prompt('新用户名:');if(!name)return;
    var pwd=prompt('密码:');if(!pwd)return;
    sessionStorage.setItem(USER_KEY,name);loggedUser=name;
    document.getElementById('login-gate').style.display='none';
    document.getElementById('main-app').style.display='block';
    initApp();
  });

  function isAdmin(){return ADMIN_USERS.includes(loggedUser);}

  function initApp(){
    document.getElementById('current-user').textContent=loggedUser+(isAdmin()?' (管理员)':'');
    if(isAdmin()) document.getElementById('admin-tab').style.display='';
    loadData();
    bindActions();
  }

  function todayStr(){
    var d=new Date();
    return d.getFullYear()+'-'+(d.getMonth()+1).toString().padStart(2,'0')+'-'+d.getDate().toString().padStart(2,'0');
  }

  function getMonday(){
    var d=new Date();var day=d.getDay();var diff=d.getDate()-day+(day===0?-6:1);
    var m=new Date(d.setDate(diff));
    return m.getFullYear()+'-'+(m.getMonth()+1).toString().padStart(2,'0')+'-'+m.getDate().toString().padStart(2,'0');
  }

  /* ── Load all records from Supabase ── */
  async function loadData(){
    var q='/checkin_records?order=date.asc';
    try{
      var res=await supabaseFetch(q);
      cachedRecords=await res.json()||[];
    }catch(e){cachedRecords=[];}
    var myRecords=cachedRecords.filter(function(r){return r.username===loggedUser;});
    updateUI(myRecords);
    renderHistory(myRecords);
    if(isAdmin()) renderAdmin(cachedRecords);
  }

  function updateUI(myRecords){
    var today=todayStr();
    var todayRecs=myRecords.filter(function(r){return r.date===today;});

    /* 计算连续天数：从今天往前数，只有 did=true 才算连续 */
    var streak=0;
    var d=new Date();
    for(var i=0;i<365;i++){
      var s=d.getFullYear()+'-'+(d.getMonth()+1).toString().padStart(2,'0')+'-'+d.getDate().toString().padStart(2,'0');
      var found=myRecords.some(function(r){return r.date===s && r.did===true;});
      if(!found) break;
      streak++;
      d.setDate(d.getDate()-1);
    }

    /* 本周记录 */
    var mon=getMonday();
    var weekTotal=myRecords.filter(function(r){return r.did && r.date>=mon;}).length;

    /* 本月记录 */
    var mo=today.substring(0,7);
    var monthTotal=myRecords.filter(function(r){return r.did && r.date.substring(0,7)===mo;}).length;

    /* 最佳连续 */
    var best=0,cur=0;
    var sorted=myRecords.slice().sort(function(a,b){return a.date.localeCompare(b.date);});
    for(var i=0;i<sorted.length;i++){
      if(sorted[i].did){cur++;if(cur>best)best=cur;}
      else cur=0;
    }

    document.getElementById('week-count').textContent=weekTotal+'天';
    document.getElementById('month-count').textContent=monthTotal+'天';
    document.getElementById('cur-streak').textContent=streak+'天';
    document.getElementById('best-streak').textContent=best+'天';

    var sd=document.getElementById('streak-display');
    var msg=document.getElementById('msg-display');

    if(todayRecs.length>0 && todayRecs.some(function(r){return r.did;})){
      var n=todayRecs.reduce(function(s,r){return s+(r.did?r.count:0);},0);
      sd.textContent='今日已破戒 ('+n+'次)';
      sd.style.color='#e31b6d';
      var shameIdx=Math.min(n,SHAME.length-1);
      msg.textContent=SHAME[shameIdx];
      if(streak>=3) msg.textContent+='\n但你已经连续'+streak+'天的纪录就这么毁了...白坚持了';
    } else if(todayRecs.length>0 && todayRecs.some(function(r){return r.did===false;})){
      sd.textContent='今日打卡：未破戒 ✓';
      sd.style.color='#66d9ed';
      if(streak>=7) msg.innerHTML='连续7天！你已经超过99%的男生！<br><span style="color:#ff6b2b;">🏆 恭喜获得铁男称号！今晚奖励自己一顿好的！</span>';
      else if(streak>=5) msg.textContent='连续5天！金刚不坏之身初成，继续保持！';
      else if(streak>=3) msg.textContent='连续3天！元始天尊都为你点赞！';
      else if(streak>=2) msg.textContent='连续2天！超过了全国50%的男生，继续！';
      else if(streak>=1) msg.textContent='好样的！今天管住手了！';
      else msg.textContent='今日平安！明天继续加油！';
    } else {
      if(streak>0){
        sd.textContent='今日未打卡（当前连续'+streak+'天）';
        sd.style.color='#66d9ed';
        msg.textContent='今天还没打卡，别忘了！坚持就是胜利！';
      } else {
        sd.textContent='今天还没打卡';
        sd.style.color='rgba(255,255,255,0.4)';
        msg.textContent='新的一天，记录今天的状态吧！';
      }
    }
  }

  function renderHistory(myRecords){
    var wrap=document.getElementById('history-table-wrap');
    var sorted=myRecords.slice().sort(function(a,b){return b.date.localeCompare(a.date);});
    if(sorted.length===0){wrap.innerHTML='<div class="font-mono text-sm" style="color:rgba(255,255,255,0.2);text-align:center;padding:40px 0;">暂无记录</div>';return;}
    var html='<table style="width:100%;border-collapse:collapse;font-family:JetBrains Mono,monospace;font-size:12px;">';
    html+='<thead><tr style="border-bottom:1px solid rgba(255,255,255,0.06);">';
    html+='<th style="padding:8px 10px;text-align:left;color:rgba(255,255,255,0.25);">日期</th>';
    html+='<th style="padding:8px 10px;text-align:center;color:rgba(255,255,255,0.25);">状态</th>';
    html+='<th style="padding:8px 10px;text-align:center;color:rgba(255,255,255,0.25);">次数</th>';
    html+='<th style="padding:8px 10px;text-align:right;color:rgba(255,255,255,0.25);">挖苦/鼓励</th>';
    html+='</tr></thead><tbody>';
    sorted.forEach(function(r){
      var shame=r.did?SHAME[Math.min(r.count,SHAME.length-1)]:(r.streak>=3?'坚持就是胜利！':'继续保持！');
      var status=r.did?'<span style="color:#e31b6d;">破戒</span>':'<span style="color:#66d9ed;">平安</span>';
      html+='<tr style="border-bottom:1px solid rgba(255,255,255,0.03);">';
      html+='<td style="padding:8px 10px;color:rgba(255,255,255,0.5);">'+r.date+'</td>';
      html+='<td style="padding:8px 10px;text-align:center;">'+status+'</td>';
      html+='<td style="padding:8px 10px;text-align:center;color:rgba(255,255,255,0.4);">'+(r.did?r.count+'次':'-')+'</td>';
      html+='<td style="padding:8px 10px;text-align:right;color:rgba(255,255,255,0.3);font-size:10px;">'+shame.substring(0,20)+'...</td>';
      html+='</tr>';
    });
    html+='</tbody></table>';
    wrap.innerHTML=html;
  }

  function renderAdmin(all){
    var list=document.getElementById('admin-list');
    var users={};
    all.forEach(function(r){
      if(!users[r.username]) users[r.username]={records:[]};
      users[r.username].records.push(r);
    });
    var html='<table style="width:100%;border-collapse:collapse;font-family:JetBrains Mono,monospace;font-size:12px;">';
    html+='<thead><tr style="border-bottom:1px solid rgba(255,255,255,0.06);">';
    html+='<th style="padding:8px 10px;text-align:left;color:rgba(255,255,255,0.25);">用户</th>';
    html+='<th style="padding:8px 10px;text-align:center;color:rgba(255,255,255,0.25);">总天数</th>';
    html+='<th style="padding:8px 10px;text-align:center;color:rgba(255,255,255,0.25);">破戒</th>';
    html+='<th style="padding:8px 10px;text-align:center;color:rgba(255,255,255,0.25);">平安</th>';
    html+='<th style="padding:8px 10px;text-align:center;color:rgba(255,255,255,0.25);">当前连续</th>';
    html+='<th style="padding:8px 10px;text-align:center;color:rgba(255,255,255,0.25);">最长连续</th>';
    html+='</tr></thead><tbody>';
    Object.keys(users).forEach(function(u){
      var recs=users[u].records;
      var didCount=recs.filter(function(r){return r.did;}).length;
      var notCount=recs.length-didCount;
      var streak=0;var d=new Date();
      for(var i=0;i<365;i++){
        var s=d.getFullYear()+'-'+(d.getMonth()+1).toString().padStart(2,'0')+'-'+d.getDate().toString().padStart(2,'0');
        if(!recs.some(function(r){return r.date===s&&r.did;})) break;
        streak++;d.setDate(d.getDate()-1);
      }
      var best=0,cur=0;
      var sorted=recs.slice().sort(function(a,b){return a.date.localeCompare(b.date);});
      for(var i=0;i<sorted.length;i++){if(sorted[i].did){cur++;if(cur>best)best=cur;}else cur=0;}
      html+='<tr style="border-bottom:1px solid rgba(255,255,255,0.03);">';
      html+='<td style="padding:8px 10px;color:#fff;">'+u+'</td>';
      html+='<td style="padding:8px 10px;text-align:center;color:rgba(255,255,255,0.5);">'+recs.length+'天</td>';
      html+='<td style="padding:8px 10px;text-align:center;color:#e31b6d;">'+didCount+'天</td>';
      html+='<td style="padding:8px 10px;text-align:center;color:#66d9ed;">'+notCount+'天</td>';
      html+='<td style="padding:8px 10px;text-align:center;color:rgba(255,255,255,0.5);">'+streak+'天</td>';
      html+='<td style="padding:8px 10px;text-align:center;color:rgba(255,255,255,0.5);">'+best+'天</td>';
      html+='</tr>';
    });
