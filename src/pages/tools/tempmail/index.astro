---
import PageLayout from "../../../layouts/PageLayout.astro";
---

<PageLayout title="TempMail — DreaMax Tools | Disposable Email">
  <section class="min-h-screen px-6 pt-32 pb-24">
    <div class="mx-auto" style="max-width:900px;">
      <a href="/tools" class="font-mono text-sm link-underline" style="color:rgba(255,255,255,0.4);">&larr; Back to Tools</a>

      <h1 class="section-heading" style="margin:24px 0 8px;">
        <span class="accent-bar" style="background:#66d9ed;"></span>TempMail
      </h1>
      <p class="font-mono text-sm" style="color:rgba(255,255,255,0.4);">临时邮箱，保护隐私。无需注册，用完即弃。</p>

      <!-- Generate area -->
      <div class="generate-area" style="margin-top:32px;">
        <div class="flex flex-col md:flex-row gap-4 items-start md:items-center">
          <button id="btn-generate" class="btn btn-pink" style="padding:12px 28px;font-size:13px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            生成新邮箱
          </button>
          <div id="email-display" class="email-box" style="display:none;">
            <span id="email-address" style="font-family:'JetBrains Mono',monospace;font-size:15px;color:#66d9ed;word-break:break-all;"></span>
            <button id="btn-copy" class="btn btn-ghost" style="padding:6px 14px;font-size:11px;margin-left:8px;flex-shrink:0;">复制</button>
          </div>
        </div>
        <div id="status-msg" class="font-mono text-xs" style="color:rgba(255,255,255,0.25);margin-top:12px;">点击按钮生成临时邮箱</div>
      </div>

      <!-- Inbox -->
      <div id="inbox-area" style="display:none;margin-top:32px;">
        <h2 class="font-sans text-lg font-semibold text-white" style="margin-bottom:16px;">📥 收件箱</h2>
        <div id="message-list" class="flex flex-col gap-2">
          <div class="font-mono text-sm" style="color:rgba(255,255,255,0.2);text-align:center;padding:40px 0;">暂无邮件</div>
        </div>
      </div>

      <!-- Message detail modal -->
      <div id="msg-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;background:rgba(0,0,0,0.7);backdrop-filter:blur(8px);padding:20px;">
        <div class="msg-modal-content" style="max-width:640px;margin:60px auto;background:#131316;border:1px solid rgba(255,255,255,0.06);border-radius:16px;padding:24px;max-height:80vh;overflow-y:auto;">
          <div class="flex justify-between items-start mb-4">
            <h3 id="modal-subject" class="font-sans text-lg font-semibold text-white" style="margin:0;"></h3>
            <button id="modal-close" class="btn btn-ghost" style="padding:4px 12px;font-size:11px;">关闭</button>
          </div>
          <div class="font-mono text-xs" style="color:rgba(255,255,255,0.3);margin-bottom:12px;">
            <span id="modal-from"></span> · <span id="modal-date"></span>
          </div>
          <div id="modal-body" style="font-size:14px;color:rgba(255,255,255,0.6);line-height:1.6;white-space:pre-wrap;word-break:break-word;"></div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script>
(function(){
  var API_BASE = 'https://api.mail.tm';
  var account = null;  // { id, address, token }
  var pollTimer = null;
  var currentMessages = [];

  var btnGen = document.getElementById('btn-generate');
  var emailDisplay = document.getElementById('email-display');
  var emailAddr = document.getElementById('email-address');
  var btnCopy = document.getElementById('btn-copy');
  var statusMsg = document.getElementById('status-msg');
  var inboxArea = document.getElementById('inbox-area');
  var msgList = document.getElementById('message-list');
  var msgModal = document.getElementById('msg-modal');
  var modalSubject = document.getElementById('modal-subject');
  var modalFrom = document.getElementById('modal-from');
  var modalDate = document.getElementById('modal-date');
  var modalBody = document.getElementById('modal-body');
  var modalClose = document.getElementById('modal-close');

  /* ── Generate ── */
  btnGen.addEventListener('click', generate);

  /* Copy */
  btnCopy.addEventListener('click', function(){
    navigator.clipboard.writeText(emailAddr.textContent).then(function(){
      btnCopy.textContent = '已复制';
      setTimeout(function(){ btnCopy.textContent = '复制'; }, 1500);
    });
  });

  modalClose.addEventListener('click', function(){ msgModal.style.display = 'none'; });
  msgModal.addEventListener('click', function(e){ if(e.target === msgModal) msgModal.style.display = 'none'; });

  function generate(){
    btnGen.disabled = true;
    btnGen.textContent = '生成中...';
    statusMsg.textContent = '正在创建邮箱...';

    /* Step 1: Get domain */
    fetch(API_BASE + '/domains')
      .then(function(r){ return r.json(); })
      .then(function(data){
        var domain = data['hydra:member'][0].domain;
        var local = randomString(10);
        var addr = local + '@' + domain;

        /* Step 2: Create account */
        return fetch(API_BASE + '/accounts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ address: addr, password: 'temp123456' })
        });
      })
      .then(function(r){ return r.json(); })
      .then(function(acc){
        /* Step 3: Get token */
        return fetch(API_BASE + '/token', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ address: acc.address, password: 'temp123456' })
        }).then(function(r){ return r.json(); })
        .then(function(t){
          account = { id: acc.id, address: acc.address, token: t.token };
          emailAddr.textContent = account.address;
          emailDisplay.style.display = 'flex';
          statusMsg.textContent = '✅ 邮箱已就绪，等待接收邮件...';
          inboxArea.style.display = 'block';
          msgList.innerHTML = '<div class="font-mono text-sm" style="color:rgba(255,255,255,0.2);text-align:center;padding:40px 0;">暂无邮件</div>';
          startPolling();
        });
      })
      .catch(function(err){
        statusMsg.textContent = '❌ 创建失败，请重试';
        console.error(err);
      })
      .finally(function(){
        btnGen.disabled = false;
        btnGen.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>生成新邮箱';
      });
  }

  /* ── Poll inbox ── */
  function startPolling(){
    if(pollTimer) clearInterval(pollTimer);
    pollInbox();
    pollTimer = setInterval(pollInbox, 5000);
  }

  function pollInbox(){
    if(!account) return;
    fetch(API_BASE + '/messages', {
      headers: { 'Authorization': 'Bearer ' + account.token }
    })
    .then(function(r){ return r.json(); })
    .then(function(data){
      var msgs = data['hydra:member'] || [];
      if(JSON.stringify(msgs) !== JSON.stringify(currentMessages)){
        currentMessages = msgs;
        renderMessages(msgs);
      }
    })
    .catch(function(){});
  }

  function renderMessages(msgs){
    if(msgs.length === 0){
      msgList.innerHTML = '<div class="font-mono text-sm" style="color:rgba(255,255,255,0.2);text-align:center;padding:40px 0;">暂无邮件</div>';
      return;
    }
    var html = '';
    msgs.forEach(function(msg){
      html += '<div class="msg-item" data-id="'+msg.id+'" style="padding:14px 16px;border:1px solid rgba(255,255,255,0.06);border-radius:8px;cursor:pointer;transition:all 0.2s;background:rgba(255,255,255,0.02);">';
      html += '  <div style="font-size:14px;color:rgba(255,255,255,0.7);font-weight:500;">'+esc(msg.subject || '(无主题)')+'</div>';
      html += '  <div style="font-family:\'JetBrains Mono\',monospace;font-size:11px;color:rgba(255,255,255,0.3);margin-top:4px;">'+esc(msg.from.address)+'</div>';
      html += '  <div style="font-family:\'JetBrains Mono\',monospace;font-size:10px;color:rgba(255,255,255,0.15);margin-top:2px;">'+msg.createdAt+'</div>';
      html += '</div>';
    });
    msgList.innerHTML = html;

    /* Click to read */
    msgList.querySelectorAll('.msg-item').forEach(function(el){
      el.addEventListener('click', function(){
        var id = el.getAttribute('data-id');
        readMessage(id);
      });
      el.addEventListener('mouseenter', function(){ el.style.borderColor = 'rgba(102,217,237,0.3)'; el.style.background = 'rgba(102,217,237,0.04)'; });
      el.addEventListener('mouseleave', function(){ el.style.borderColor = 'rgba(255,255,255,0.06)'; el.style.background = 'rgba(255,255,255,0.02)'; });
    });
  }

  function readMessage(id){
    fetch(API_BASE + '/messages/' + id, {
      headers: { 'Authorization': 'Bearer ' + account.token }
    })
    .then(function(r){ return r.json(); })
    .then(function(msg){
      modalSubject.textContent = msg.subject || '(无主题)';
      modalFrom.textContent = '发件人: ' + msg.from.address;
      modalDate.textContent = msg.createdAt;
      modalBody.textContent = msg.html && msg.html.length > msg.text.length ? stripHtml(msg.html) : (msg.text || '(无内容)');
      msgModal.style.display = 'block';
    })
    .catch(function(){});
  }

  function stripHtml(html){
    var d = document.createElement('div');
    d.innerHTML = html;
    return d.textContent || d.innerText || '';
  }

  function esc(s){
    if(!s) return '';
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function randomString(len){
    var chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
    var r = '';
    for(var i=0;i<len;i++) r += chars[Math.floor(Math.random() * chars.length)];
    return r;
  }
})();
</script>

<style>
.email-box {
  display: flex;
  align-items: center;
  padding: 10px 16px;
  background: rgba(102,217,237,0.04);
  border: 1px solid rgba(102,217,237,0.15);
  border-radius: 8px;
}
.msg-item:last-child { margin-bottom: 0; }
</style>
