---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="DreaMax 文件分享">
  <section class="flex min-h-screen items-center justify-center px-6" style="background:#121216;">
    <div class="w-full" style="max-width:480px;">
      <div class="text-center mb-8">
        <div class="font-sans text-2xl font-bold text-white tracking-wider">DreaMax <span style="color:#66d9ed;">文件分享</span></div>
      </div>

      <div class="p-8" style="border:1px solid rgba(255,255,255,0.06);border-radius:16px;background:linear-gradient(135deg,rgba(18,18,30,0.95),rgba(26,26,46,0.95));box-shadow:0 20px 60px rgba(0,0,0,0.3);">
        <!-- Input area (shown initially) -->
        <div id="input-area" style="text-align:center;">
          <div style="width:48px;height:48px;border-radius:50%;background:rgba(102,217,237,0.1);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#66d9ed" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          </div>
          <h2 class="font-sans text-lg font-semibold text-white" style="margin:0;">输入提取码下载文件</h2>
          <p class="font-mono text-xs" style="color:rgba(255,255,255,0.25);margin-top:6px;margin-bottom:20px;">提取码已自动填入，点击提取即可</p>
          <div style="display:flex;gap:10px;">
            <input type="text" id="code-input" placeholder="6位提取码" maxlength="6" style="flex:1;padding:12px 16px;border-radius:10px;border:1px solid rgba(255,255,255,0.06);background:rgba(255,255,255,0.03);color:#fff;font-family:JetBrains Mono,monospace;font-size:16px;letter-spacing:4px;outline:none;text-align:center;" />
            <button id="btn-get" style="padding:12px 24px;border-radius:10px;border:none;background:linear-gradient(135deg,#e31b6d,#d62d80);color:#fff;font-family:JetBrains Mono,monospace;font-size:14px;font-weight:600;cursor:pointer;white-space:nowrap;">提取</button>
          </div>
          <div id="err-msg" class="font-mono text-xs" style="color:#e31b6d;margin-top:10px;display:none;"></div>
        </div>

        <!-- Download area (shown after code verified) -->
        <div id="dl-area" style="display:none;">
          <div style="text-align:center;">
            <div style="width:56px;height:56px;border-radius:50%;background:rgba(52,168,83,0.1);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#34A853" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            </div>
            <h2 class="font-sans text-lg font-semibold text-white" style="margin:0;" id="dl-filename"></h2>
            <p class="font-mono text-xs" style="color:rgba(255,255,255,0.25);margin-top:4px;" id="dl-filesize"></p>
            <a id="dl-btn" class="btn btn-pink" style="margin-top:20px;display:inline-flex;padding:12px 40px;font-size:14px;text-decoration:none;">下载文件</a>
            <p class="font-mono text-xs" style="color:rgba(255,255,255,0.12);margin-top:10px;">文件由 DreaMax 网盘分享</p>
          </div>
        </div>
      </div>

      <p class="font-mono text-xs" style="color:rgba(255,255,255,0.1);text-align:center;margin-top:24px;">Powered by DreaMax</p>
    </div>
  </section>

  <div class="grain-overlay"></div>
</BaseLayout>

<script>
(function(){
  var WORKER_URL = 'https://old-hall-b586.3752703718.workers.dev';
  var codeInput = document.getElementById('code-input');
  var btnGet = document.getElementById('btn-get');
  var errMsg = document.getElementById('err-msg');
  var inputArea = document.getElementById('input-area');
  var dlArea = document.getElementById('dl-area');
  var dlFilename = document.getElementById('dl-filename');
  var dlFilesize = document.getElementById('dl-filesize');
  var dlBtn = document.getElementById('dl-btn');

  // Auto-fill code from URL
  var params = new URLSearchParams(window.location.search);
  var autoCode = params.get('code');
  if(autoCode){ codeInput.value = autoCode; doGet(); }

  codeInput.addEventListener('keydown', function(e){ if(e.key==='Enter') doGet(); });
  btnGet.addEventListener('click', doGet);

  function doGet(){
    var code = codeInput.value.trim();
    if(!code || code.length !== 6){ errMsg.textContent = '请输入6位提取码'; errMsg.style.display='block'; return; }
    errMsg.style.display = 'none';
    btnGet.textContent = '提取中...';
    btnGet.disabled = true;

    fetch(WORKER_URL + '/download?code=' + code)
      .then(function(r){ return r.json(); })
      .then(function(d){
        if(d.error || d.e){ errMsg.textContent = '提取码无效'; errMsg.style.display='block'; btnGet.textContent='提取'; btnGet.disabled=false; return; }
        inputArea.style.display = 'none';
        dlArea.style.display = 'block';
        dlFilename.textContent = d.filename || '未知文件';
        dlFilesize.textContent = formatSize(d.filesize || 0);
        // 用 Worker 代理下载，不走 B2 直链
        dlBtn.href = WORKER_URL + '/proxy?code=' + code;
        dlBtn.setAttribute('download', d.filename || 'download');
      })
      .catch(function(e){ errMsg.textContent = '获取失败，请重试'; errMsg.style.display='block'; })
      .finally(function(){ btnGet.textContent='提取'; btnGet.disabled=false; });
  }

  function formatSize(b){
    if(b<1024) return b+'B'; if(b<1024*1024) return (b/1024).toFixed(1)+'KB';
    return (b/(1024*1024)).toFixed(1)+'MB';
  }
})();
</script>
