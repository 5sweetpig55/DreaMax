---
import PageLayout from "./PageLayout.astro";

interface Props {
  title: string;
  date: string;
  category: string;
  tags?: string[];
  description?: string;
}

const { title, date, category, tags = [], description } = Astro.props;
const metaDesc = description || `${title} — Tech analysis and industry insights by DreaMax.`;
---

<PageLayout {title} description={metaDesc}>
  <article style="max-width:760px; margin:0 auto;" class="px-6 pt-32 pb-24 min-h-screen">
    <header class="mb-12" style="border-bottom:1px solid rgba(255,255,255,0.05); padding-bottom:24px;">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono text-xs" style="color:#c586c0; letter-spacing:2px;">{category}</span>
        <span class="font-mono text-xs text-white/20">&middot;</span>
        <span class="font-mono text-xs text-white/25">{date}</span>
      </div>
      <h1 class="font-sans text-3xl font-semibold text-white md:text-4xl" style="line-height:1.3;">{title}</h1>
      {tags.length > 0 && (
        <div class="flex gap-2 mt-4">
          {tags.map(tag => <span class="rounded-full border border-white/8 px-3 py-0.5 font-mono text-xs text-white/35">{tag}</span>)}
        </div>
      )}
    </header>
    <div class="prose-content">
      <slot />
    </div>
  </article>
</PageLayout>

<style>
  .highlight-text {
    color: #66d9ed;
    font-weight: 500;
  }
  .prose-content h2 {
    color: #ffffff;
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .prose-content h2:first-child {
    margin-top: 0;
  }
</style>
